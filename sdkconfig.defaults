# HB-RF-ETH Default Configuration
# Compatible with ESP-IDF v6.1

# Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Flash size (4 MB WROOM-32)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# MQTT 3.1.1 Protocol
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_TRANSPORT_SSL=y

# HTTP Server
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y

# TLS certificate verification: use the full Mozilla root CA bundle for the
# optional outbound HTTPS clients (HTTPS webhooks, TLS
# syslog and MQTT). Manual firmware uploads arrive from the browser and do not
# download an image over HTTPS on the ESP32.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# Permit the explicit MQTT "skip verify" setting for private/self-signed lab
# brokers. All firmware-owned HTTPS clients attach the CA bundle explicitly.
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y

# mbedTLS dynamic buffers: the WROOM-32 has no PSRAM, so heap during a TLS
# handshake is scarce. With static buffers mbedTLS reserves a full 16 KB RX
# buffer (CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN) for the entire connection, which
# - combined with application response buffers - starved the PSA-crypto signature
# verification and aborted the handshake with PSA_ERROR_INSUFFICIENT_MEMORY
# (mbedtls_ssl_handshake returned -0x008D / -141). Dynamic buffers allocate the RX/TX buffers to the
# actual record size and free per-connection state when idle, freeing the heap
# the handshake needs.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y

# TLS peers may legally send records with up to 16 KiB of plaintext. Keep the
# TX side small, but accept standards-compliant incoming records from any
# configured HTTPS/TLS service.
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096

# FreeRTOS: disable backward-compat (portTICK_PERIOD_MS etc.)
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=n

# FreeRTOS: needed for CPU usage monitoring (uxTaskGetSystemState)
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# The HB-RF-ETH board uses Ethernet (LAN8720A) only. These legacy symbols are
# retained as documentation; ESP-IDF v6.1 may still resolve its promptless
# Wi-Fi component symbol internally, but the application never initializes it.
# CONFIG_ESP_WIFI_ENABLED is not set
# CONFIG_ESP32_WIFI_ENABLED is not set

# LwIP socket pool: 10 sockets is too tight for concurrent httpd (WebUI polling),
# MQTT client, monitoring listeners and outbound HTTPS clients. With only 10
# sockets the device can hit EMFILE (errno 23), preventing httpd from accepting
# a manual firmware upload. 16 gives the subsystems sufficient headroom.
CONFIG_LWIP_MAX_SOCKETS=16

# Reduce TCP TIME_WAIT from the default 60s to 15s. The 60s MSL meant that
# after every outbound HTTPS fetch (for example a webhook)
# the socket FD was unavailable for a full minute,
# compounding the socket-exhaustion problem above.
CONFIG_LWIP_TCP_MSL=15000

# Heap poisoning (light): field data from the tick sentinel (issue #362)
# shows single-core freezes with no preceding fault - consistent with a
# silent memory corruption hitting lock/heap structures. Light poisoning
# puts canaries around every allocation and verifies them on free, turning
# a silent wild write into an abort with a distinguishable reset reason
# ("Software Reset (panic)" instead of "Interrupt Watchdog") so field
# devices can report the culprit class without a serial console.
CONFIG_HEAP_POISONING_LIGHT=y

# UART ISR in IRAM (issue #362): the radio-module UART (UART1, 115200 baud)
# must keep being serviced while a flash write/erase has the cache disabled.
# With the ISR in flash it is masked for the whole flash window, the 128-byte
# hardware FIFO overflows within ~10 ms, and the driver's overflow recovery
# spins in an ISR critical section on a FIFO counter the ESP32 errata
# (UART-3.17) documents as unreliable. Costs ~4 KB of IRAM, no DRAM.
CONFIG_UART_ISR_IN_IRAM=y
